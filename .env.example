# Скопируйте этот файл в .env и заполните.

# --- Gemini API, бесплатный ключ: https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
# AI_MODEL=gemini-3.8-flash
# AI_THINKING=high        # minimal | low | medium | high

# --- Polar AccessLink (https://admin.polaraccesslink.com) ---
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
# Должен совпадать с Redirect URL, указанным при создании клиента:
# POLAR_REDIRECT_URI=http://localhost:5000/oauth2_callback

# --- Прочее ---
# PORT=5000
# HR_MAX=190
